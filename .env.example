# Copy to .env.local and fill in. Never commit real values.
# Both values are PUBLIC by design (shipped to the browser). Data is protected
# by Row Level Security in Postgres, not by hiding these.
# Find them in Supabase Dashboard → Project Settings → API.

# Your project URL, e.g. https://abcdefghijklmno.supabase.co
VITE_SUPABASE_URL=

# The publishable (anon) key. NEVER put the service_role / secret key here.
VITE_SUPABASE_PUBLISHABLE_KEY=
